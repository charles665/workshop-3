# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=happiness-events
KAFKA_CONSUMER_GROUP=happiness-ml-team
PRODUCER_DELAY_SECONDS=0.5

# PostgreSQL Configuration (puerto 5433 en host para evitar conflicto con PostgreSQL local en 5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=happiness_db
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_password
